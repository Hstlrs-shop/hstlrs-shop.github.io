# URL pública donde se publica la app (con https en producción)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Carpeta donde se guarda la base de datos SQLite (usa un volumen persistente)
DATA_DIR=./data

# Mercado Pago (https://www.mercadopago.com/developers/panel/app)
# Credenciales de producción > Access Token. Sin token, en desarrollo los pagos se simulan.
MP_ACCESS_TOKEN=
# Webhooks > Clave secreta. Obligatoria en producción.
MP_WEBHOOK_SECRET=

# Moneda de tu cuenta de Mercado Pago (México: MXN)
CURRENCY=MXN
# Precios mensuales, IVA incluido
PRICE_BASICO=499
PRICE_PROFESIONAL=899
PRICE_RED=1599
TRIAL_DAYS=14
# Días de acceso extra cuando falla un cobro
GRACE_DAYS=7

# Emails con acceso a /admin.html (separados por coma)
ADMIN_EMAILS=
# Email de contacto que aparece en la web de ventas
CONTACT_EMAIL=
# WhatsApp de ventas y soporte, con código de país y sin signos (México: 52 + 10 dígitos)
WHATSAPP=

# Asistente de IA (Claude, de Anthropic). Crea la clave en https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Esfuerzo de razonamiento: low (rápido y económico), medium o high
AI_EFFORT=low
# Consultas al mes por taller según el plan, y durante la prueba gratis
AI_MESSAGES_BASICO=100
AI_MESSAGES_PROFESIONAL=400
AI_MESSAGES_RED=1500
AI_TRIAL_MESSAGES=50
# Máximo de consultas por usuario por minuto
AI_PER_MINUTE=8
